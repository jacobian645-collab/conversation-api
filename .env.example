# Copy to .env (never commit it). Everything is optional: with nothing set, the API runs on the offline mock model.

# ---- server ----
# CONVO_API_KEY=change-me                 # required on /v1/* when set (X-API-Key or Authorization: Bearer)
# CONVO_DEFAULT_MODEL=smart               # catalog name or alias; default: mock
# CONVO_PORT=8080
# CONVO_HOST=127.0.0.1                    # 0.0.0.0 in containers
# CONVO_STORE=sqlite                      # memory (default) | sqlite
# CONVO_SQLITE_PATH=data/conversations.db
# CONVO_ALLOW_ADHOC_MODELS=true           # allow provider:model-id names not in the catalog
# CONVO_MODELS_FILE=config/models.yaml

# ---- Amazon Bedrock (AWS CloudShell already has credentials) ----
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# BEDROCK_SONNET_ID=global.anthropic.claude-sonnet-5-5

# ---- Anthropic ----
# ANTHROPIC_API_KEY=

# ---- OpenAI ----
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# ---- Azure OpenAI (no key = Entra ID via az login / managed identity) ----
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Google Gemini ----
# GEMINI_API_KEY=                          # Gemini API
# GOOGLE_CLOUD_PROJECT=                    # Vertex AI (gemini-vertex), uses ADC
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- Ollama / any OpenAI-compatible server ----
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
